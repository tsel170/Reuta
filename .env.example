# Server
PORT=3001
NODE_ENV=development

# MongoDB — leave empty to use the local JSON file store
MONGODB_URI=

# Shared secret for manual message ingestion (never expose to the frontend)
INGEST_SECRET=change-me

STORE_TIMEZONE=Asia/Jerusalem

# WhatsApp group invite (chat.whatsapp.com / wa.me). Server-only, no VITE_ prefix.
WHATSAPP_INVITE_URL=

# Vercel → Render. Set on Vercel as Config or Sensitive, name API_URL, no VITE_.
# Example: https://your-service.onrender.com
API_URL=

# Admin OTP sessions. Change SESSION_SECRET in production.
SESSION_SECRET=change-me
# Comma-separated allow-list. Additional emails: npm run add-admin -- email@example.com
ADMIN_EMAILS=tsvilevi5@gmail.com

# Optional SMTP. Without it, OTP codes are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
